{
  "name": "apollo3",
  "private": true,
  "description": "Monorepo containing Apollo front and back end code",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=4096' eslint --max-warnings 0",
    "build:shared": "pnpm --filter @apollo-annotation/mst --filter @apollo-annotation/common --filter @apollo-annotation/entities --filter @apollo-annotation/shared run build",
    "release": "tsx scripts/makeGitTag.ts",
    "start": "pnpm --filter @apollo-annotation/collaboration-server run start",
    "start:persist": "pnpm --filter @apollo-annotation/collaboration-server run start:persist",
    "start:fresh": "pnpm --filter @apollo-annotation/collaboration-server run start:fresh",
    "regenerate-demo-db": "node --experimental-strip-types scripts/regenerate-demo-db.ts",
    "test": "pnpm -r run test:ci",
    "typecheck": "pnpm tsc -b"
  },
  "devDependencies": {
    "@apollo-annotation/shared": "workspace:^",
    "@eslint/js": "^9.39.4",
    "@gmod/gff": "^2.1.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.12.0",
    "@types/semver": "^7.7.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/parser": "^8.58.0",
    "cross-env": "^7.0.3",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.27.4",
    "eslint": "9.21.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unicorn": "^57.0.0",
    "globals": "^15.15.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^2.5.22",
    "react": "^18.3.1",
    "semver": "^7.7.4",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "yargs": "^17.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
