# Required
URL=https://apollo.example.com
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_SECRET=change-me-to-another-random-string-at-least-32-chars

# Path to JBrowse static files + genomic data on the host
JBROWSE_DIR=/path/to/jbrowse-and-data

# Optional
PORT=80
POSTGRES_PASSWORD=apollo
ALLOW_GUEST_USER=false
DEFAULT_NEW_USER_ROLE=none
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
