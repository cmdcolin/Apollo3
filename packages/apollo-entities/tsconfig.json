{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "strictPropertyInitialization": false,
  },
  "include": ["./src"],
  "exclude": ["./src/**/*.test.ts"],
  "references": [{ "path": "../apollo-common" }],
}
