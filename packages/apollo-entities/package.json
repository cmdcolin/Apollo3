{
  "name": "@apollo-annotation/entities",
  "version": "0.3.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/Apollo3.git",
    "directory": "packages/apollo-entities"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:ci": "jest --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "dependencies": {
    "@apollo-annotation/common": "workspace:^",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/mongodb": "^6.4.0",
    "@mikro-orm/nestjs": "^6.0.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@mikro-orm/sqlite": "^6.4.0",
    "tslib": "^2.3.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.3",
    "@mikro-orm/libsql": "^6.4.0",
    "@nestjs/common": "^10.1.0",
    "@nestjs/core": "^10.1.0",
    "@types/jest": "^27.0.1",
    "@types/node": "^20.19.15",
    "jest": "^29.6.2",
    "reflect-metadata": "^0.1.13",
    "ts-jest": "^29.1.1",
    "typescript": "^5.5.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
