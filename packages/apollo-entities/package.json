{
  "name": "@apollo-annotation/entities",
  "version": "0.3.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/Apollo3.git",
    "directory": "packages/apollo-entities"
  },
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "pnpm clean && tsc --build",
    "clean": "tsc --build --clean",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "dependencies": {
    "@apollo-annotation/common": "workspace:^",
    "@mikro-orm/core": "^7.0.1",
    "@mikro-orm/mongodb": "^7.0.1",
    "@mikro-orm/postgresql": "^7.0.1",
    "@mikro-orm/sqlite": "^7.0.1",
    "tslib": "^2.3.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.3",
    "@nestjs/common": "^10.1.0",
    "@nestjs/core": "^10.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.9",
    "jest": "^29.6.2",
    "jest-util": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
