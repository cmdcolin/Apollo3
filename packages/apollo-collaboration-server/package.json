{
  "name": "@apollo-annotation/collaboration-server",
  "private": true,
  "description": "",
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "scripts": {
    "dev:build": "node scripts/dev-build.mjs",
    "build": "pnpm dev:build && pnpm --filter @apollo-annotation/web-ui build",
    "build:client": "pnpm --filter @apollo-annotation/web-ui build",
    "e2e:start": "LOG_LEVELS=error,warn pnpm start:no-watch",
    "start": "bash scripts/dev-start.sh",
    "start:persist": "bash scripts/dev-start.sh --persist",
    "start:fresh": "bash scripts/dev-start.sh --persist --fresh",
    "start:debug": "echo '[start] Building (esbuild)...' && pnpm dev:build && echo '[start] Starting server...' && NODE_ENV=development node --inspect --watch-path dist dist/main.js",
    "start:no-watch": "echo '[start] Building (esbuild)...' && pnpm dev:build && echo '[start] Starting server...' && NODE_ENV=development node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:cli:start": "ALLOW_ROOT_USER=true ROOT_USER_PASSWORD=pass LOG_LEVELS=error,warn pnpm start",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "babel-jest",
        {
          "plugins": [
            [
              "@babel/plugin-proposal-decorators",
              {
                "version": "legacy"
              }
            ]
          ],
          "presets": [
            [
              "@babel/preset-typescript"
            ]
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@apollo-annotation/common": "workspace:^",
    "@apollo-annotation/entities": "workspace:^",
    "@apollo-annotation/shared": "workspace:^",
    "@gmod/gff": "^2.0.0",
    "@gmod/indexedfasta": "^5.0.0",
    "@gmod/twobit": "^6.0.1",
    "@jbrowse/core": "^4.1.1",
    "@jbrowse/mobx-state-tree": "^5.5.0",
    "@mikro-orm/core": "^7.0.1",
    "@nestjs/common": "^10.1.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.1.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/mapped-types": "^2.0.2",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.1.0",
    "@nestjs/platform-socket.io": "^10.1.0",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/terminus": "^10.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.18.0",
    "express-session": "^1.17.3",
    "generic-filehandle2": "^2.0.0",
    "https-proxy-agent": "^7.0.6",
    "joi": "^17.7.0",
    "mobx": "^6.6.1",
    "mobx-state-tree": "^5.4.0",
    "multer": "^2.0.2",
    "passport": "^0.5.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.0",
    "passport-microsoft": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.4.0",
    "sanitize-filename": "^1.6.3",
    "socket.io": "^4.5.3",
    "stream-concat": "^1.0.0",
    "tslib": "^2.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@apollo-annotation/mst": "workspace:^",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/preset-typescript": "^7.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.9",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-jwt": "^3.0.6",
    "@types/passport-microsoft": "^0.0.0",
    "@types/react": "^18.3.4",
    "@types/stream-concat": "^2.0.0",
    "esbuild": "^0.27.4",
    "glob": "^13.0.6",
    "jest": "^29.6.2",
    "mongodb": "^4.7.0",
    "rimraf": "^3.0.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=14"
  }
}
