{
  "name": "@apollo-annotation/jbrowse-plugin-apollo",
  "version": "0.3.11",
  "description": "Apollo plugin for JBrowse 2",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/Apollo3.git",
    "directory": "packages/jbrowse-plugin-apollo"
  },
  "license": "Apache-2.0",
  "author": "JBrowse Team",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "browse": "serve --no-request-logging --listen 8999 --no-port-switching --symlinks .jbrowse",
    "build": "yarn build:shared && yarn clean && tsc --noEmit && yarn node esbuild.mjs",
    "clean": "rimraf dist",
    "cypress:debug": "cypress run --browser chrome --config screenshotOnRunFailure=true,video=true",
    "cypress:open": "cypress open --config baseUrl=http://localhost:3000",
    "cypress:run": "cypress run --browser chrome",
    "cypress:run:headed": "cypress run --browser chrome --headed",
    "prepack": "NODE_ENV=production yarn build",
    "prepublish": "yarn test",
    "setup": "rimraf .jbrowse && jbrowse create .jbrowse",
    "start": "yarn clean && yarn node esbuild.mjs --watch",
    "start:collab-cypress": "yarn workspace @apollo-annotation/collaboration-server run cypress:start",
    "start:e2e-servers": "concurrently --names plugin,jbrowse,collab --prefix-colors blue,green,yellow \"yarn start:server\" \"yarn browse\" \"yarn start:collab-cypress\"",
    "start:server": "serve --no-request-logging --cors --listen 9000 --no-port-switching .",
    "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
    "test:ci": "yarn node --experimental-vm-modules $(yarn bin jest) --coverage",
    "test:e2e": "yarn build && start-test \"yarn start:e2e-servers\" \"9000|8999|http://localhost:3999/health\" \"cypress run --browser chrome\"",
    "test:e2e:debug": "yarn build && start-test \"yarn start:e2e-servers\" \"9000|8999|http://localhost:3999/health\" \"cypress run --browser chrome --config screenshotOnRunFailure=true,video=true\"",
    "test:e2e:desktop": "tsx test/e2e-desktop.ts",
    "test:e2e:desktop:ci": "bash test/e2e-desktop-setup.sh && xvfb-run --auto-servernum tsx test/e2e-desktop.ts --headless",
    "test:e2e:desktop:setup": "bash test/e2e-desktop-setup.sh",
    "test:e2e:headed": "yarn build && start-test \"yarn start:e2e-servers\" \"9000|8999|http://localhost:3999/health\" \"cypress run --browser chrome --headed\"",
    "typecheck": "tsc --noEmit",
    "postversion": "git push --follow-tags"
  },
  "config": {
    "jbrowse": {
      "plugin": {
        "name": "Apollo"
      }
    }
  },
  "dependencies": {
    "@apollo-annotation/common": "workspace:^",
    "@apollo-annotation/entities": "workspace:^",
    "@apollo-annotation/mst": "workspace:^",
    "@apollo-annotation/shared": "workspace:^",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@gmod/gff": "^2.0.0",
    "@jbrowse/plugin-authentication": "^4.1.1",
    "@jbrowse/plugin-linear-genome-view": "^4.1.1",
    "@mikro-orm/core": "^7.0.1",
    "@mikro-orm/sqlite": "^7.0.1",
    "@mui/icons-material": "^7.3.7",
    "@types/jsonpath": "^0.2.0",
    "autosuggest-highlight": "^3.3.4",
    "bson-objectid": "^2.0.4",
    "clsx": "^1.1.1",
    "fast-deep-equal": "^3.1.3",
    "file-saver": "^2.0.5",
    "http-proxy-middleware": "^2.0.6",
    "idb": "^7.1.1",
    "jsonpath": "^1.1.1",
    "nanoid": "^4.0.2",
    "socket.io-client": "^4.5.4",
    "tslib": "^2.3.1"
  },
  "devDependencies": {
    "@cypress/grep": "^6.0.0",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/cli": "^4.1.1",
    "@jbrowse/core": "^4.1.1",
    "@jbrowse/mobx-state-tree": "^5.5.0",
    "@jest/globals": "^29.0.3",
    "@mui/material": "^7.3.7",
    "@mui/x-data-grid": "^8.0.0",
    "@types/autosuggest-highlight": "^3",
    "@types/file-saver": "^2",
    "@types/lodash.merge": "^4",
    "@types/node": "^24.10.9",
    "@types/prop-types": "^15",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18",
    "@types/selenium-webdriver": "^4.35.5",
    "concurrently": "^9.2.1",
    "cypress": "^15.0.0",
    "cypress-fail-fast": "^7.1.1",
    "cypress-image-diff-html-report": "^2.2.0",
    "cypress-image-diff-js": "^2.5.0",
    "cypress-terminal-report": "^7.3.3",
    "electron-chromedriver": "^40.6.0",
    "esbuild": "^0.27.3",
    "fake-indexeddb": "^4.0.2",
    "jest": "^29.6.2",
    "jest-fetch-mock": "^3.0.3",
    "jest-util": "^30.2.0",
    "librpc-web-mod": "^1.1.9",
    "lodash.merge": "^4.6.2",
    "mobx": "^6.6.1",
    "mobx-react": "^7.2.1",
    "pretty-bytes": "^7.1.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^3.0.2",
    "rxjs": "^7.4.0",
    "selenium-webdriver": "^4.41.0",
    "serve": "^14.0.1",
    "start-server-and-test": "^1.11.7",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.3.0",
    "tss-react": "^4.6.1",
    "tsx": "^4.6.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "@jbrowse/core": "^4.1.1",
    "@jbrowse/mobx-state-tree": "^5.5.0",
    "@mui/material": "^7.3.7",
    "mobx": "^6.6.1",
    "mobx-react": "^9.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "^7.4.0",
    "tss-react": "^4.6.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "jbrowse-plugin": {
    "name": "Apollo"
  }
}
